PORT=3333
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
JWT_SECRET=substitua-por-um-segredo-longo-e-aleatorio
JWT_EXPIRES_IN=8h
PASSWORD_RESET_EXPIRES_MINUTES=15

# Enquanto não há banco, estes valores criam o administrador inicial em memória.
# Remova-os quando o repositório Prisma assumir essa responsabilidade.
ADMIN_NAME=Administrador ValeSense
ADMIN_EMAIL=admin@valesense.local
ADMIN_PASSWORD=troque-esta-senha
